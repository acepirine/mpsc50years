# Public origin of the API. The frontend talks to this for every request, so
# it must be reachable from the browser.
#
# In development the API runs on :8000. In production set this to the API's
# public URL, e.g. https://api.mpsc50years.docufybd.com
#
# The API's own FRONTEND_URL and API_URL settings must point back at this app
# for the payment redirects (/payment/success, /payment/cancelled) to resolve.
VITE_API_URL=http://localhost:8000